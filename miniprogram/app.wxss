page {
  height: 100%;
  /* Brand */
  --accent: #ff2d55;
  --accent-2: #ff453a;
  --accent-soft: rgba(255, 45, 85, 0.18);
  --on-accent: #ffffff;
  --grad-accent: linear-gradient(135deg, #ff2d55 0%, #ff453a 100%);

  /* Surfaces — dark */
  --bg: #000000;
  --card: rgba(28, 28, 30, 0.5);
  --chip: #2c2c2e;
  --fill: rgba(120, 120, 128, 0.24);
  --text: #ffffff;
  --muted: rgba(235, 235, 245, 0.6);
  --muted-strong: rgba(235, 235, 245, 0.55);
  --line: rgba(84, 84, 88, 0.65);
  --dark: #000000;
  --dark-elev: #1c1c1e;
  --dark-chip: #2c2c2e;
  --dark-muted: rgba(235, 235, 245, 0.4);
  --fill-secondary: #2c2c2e;
  --label-tertiary: rgba(235, 235, 245, 0.3);
  --hairline: rgba(255, 255, 255, 0.1);
  --hairline-soft: rgba(255, 255, 255, 0.06);
  --fill-soft: rgba(255, 255, 255, 0.1);
  --fill-mid: rgba(255, 255, 255, 0.18);
  --overlay: rgba(0, 0, 0, 0.55);
  --overlay-heavy: rgba(0, 0, 0, 0.72);
  --sheet-bg: #191919;
  --elev: #1c1c1e;
  --shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
  --quality-mid: rgba(28, 28, 30, 0.72);
  --quality-end: rgba(28, 28, 30, 0.55);
  --plate-grad: radial-gradient(circle at 35% 30%, #3a3a3c 0%, #1c1c1e 55%, #0a0a0a 100%);
  --hero-0: linear-gradient(160deg, #3a3a3c 0%, #1c1c1e 55%, #0a0a0a 100%);
  --hero-1: linear-gradient(160deg, #2c2c2e 0%, #141414 60%, #000000 100%);
  --hero-2: linear-gradient(160deg, #242426 0%, #121212 60%, #000000 100%);
  --hero-3: linear-gradient(160deg, #2a2a2e 0%, #161618 55%, #000000 100%);
  --hero-selected: linear-gradient(160deg, #5a2030 0%, #2a1018 45%, #12080c 100%);
  --ring-track: rgba(255, 255, 255, 0.12);

  /* type: 5 — 含 iOS Large Title */
  --fs-sm: 24rpx;
  --fs-md: 28rpx;
  --fs-lg: 40rpx;
  --fs-title: 68rpx;
  --fs-xl: 112rpx;

  /* space: 4 */
  --s1: 10rpx;
  --s2: 20rpx;
  --s3: 32rpx;
  --s4: 44rpx;

  /* radius — card ≈ 10pt continuous */
  --r-sm: 12rpx;
  --r-md: 16rpx;
  --r-lg: 20rpx;
  --r-xl: 20rpx;
  --r-card: 20rpx;

  /* button：大圆角胶囊（半径 = 半高）；文案内边距 ≥ 24px → 48rpx */
  --btn-h: 96rpx;
  --btn-r: 48rpx;
  --btn-pad-x: 48rpx;
  --btn-pad-y: 24rpx;

  /* motion */
  --motion-fast: 120ms;
  --motion-sheet: 240ms;
  --motion-in: 280ms;
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: var(--fs-md);
  box-sizing: border-box;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  border-radius: var(--btn-r);
}

button::after {
  border-radius: var(--btn-r);
}

.page {
  position: relative;
  z-index: 1;
  min-height: 100%;
  /* 沉浸式：避让状态栏/胶囊，标题再下移；有 navPadTop 的页会用行内样式覆盖 top */
  padding: calc(env(safe-area-inset-top, 20px) + 48px + 100rpx) 32rpx 0;
  display: flex;
  flex-direction: column;
  background: transparent;
  box-sizing: border-box;
}

/* 有底部主按钮：内容区滚动，按钮贴底 */
.page-dock {
  height: 100%;
  overflow: hidden;
}

.page-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  background: transparent;
  min-height: 0;
  overflow-y: auto;
}

/* iOS Large Title */
.page-title {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: var(--text);
}

.page-sub {
  margin-top: var(--s1);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--muted);
  line-height: 1.4;
}

.card {
  background: var(--card);
  border-radius: var(--r-card);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-label {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text);
  margin-bottom: var(--s1);
}

.card-hint {
  font-size: var(--fs-sm);
  color: var(--muted);
  margin-bottom: var(--s3);
  line-height: 1.4;
}

.btn-primary {
  width: 100%;
  min-height: var(--btn-h);
  height: auto;
  border-radius: var(--btn-r);
  background: var(--accent);
  background-image: var(--grad-accent);
  color: var(--on-accent);
  font-size: var(--fs-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--btn-pad-y) var(--btn-pad-x);
  margin: 0;
  border: none;
  line-height: 1.2;
  box-sizing: border-box;
  white-space: nowrap;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  width: 100%;
  min-height: var(--btn-h);
  height: auto;
  border-radius: var(--btn-r);
  background: transparent;
  color: var(--accent);
  font-size: var(--fs-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--accent);
  padding: var(--btn-pad-y) var(--btn-pad-x);
  margin: 0;
  line-height: 1.2;
  box-sizing: border-box;
  white-space: nowrap;
}

.btn-outline::after {
  border: none;
}

.btn-link {
  margin-top: var(--s2);
  text-align: center;
  color: var(--muted);
  font-size: var(--fs-sm);
  font-weight: 500;
  padding: var(--s1) 0 var(--s3);
}

.footer {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-top: auto;
  padding: var(--s3) 0 calc(var(--s2) + env(safe-area-inset-bottom));
  background: var(--bg);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s2);
}

.chip {
  padding: var(--s2) var(--s3);
  border-radius: var(--r-md);
  background: var(--fill);
  color: var(--text);
  font-size: var(--fs-md);
  font-weight: 500;
}

.chip.active {
  background: var(--accent);
  background-image: var(--grad-accent);
  color: var(--on-accent);
}

.chip-equal {
  flex: 1;
  text-align: center;
  padding: var(--s2) var(--s1);
}

.safe-bottom {
  padding-bottom: calc(var(--s3) + env(safe-area-inset-bottom));
}

/* 当日训练总结（今日回看 / 课次总结共用） */
.quality-hero {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 28rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(
    160deg,
    rgba(255, 45, 85, 0.22) 0%,
    var(--quality-mid) 48%,
    var(--quality-end) 100%
  );
  border: 1rpx solid rgba(255, 45, 85, 0.28);
  box-sizing: border-box;
}

.quality-hero.tone-great {
  background: linear-gradient(
    160deg,
    rgba(52, 199, 89, 0.2) 0%,
    var(--quality-mid) 50%,
    var(--quality-end) 100%
  );
  border-color: rgba(52, 199, 89, 0.32);
}

.quality-hero.tone-good {
  background: linear-gradient(
    160deg,
    rgba(255, 159, 10, 0.18) 0%,
    var(--quality-mid) 50%,
    var(--quality-end) 100%
  );
  border-color: rgba(255, 159, 10, 0.28);
}

.quality-hero.tone-miss,
.quality-hero.tone-low {
  background: linear-gradient(
    160deg,
    rgba(255, 45, 85, 0.16) 0%,
    var(--quality-mid) 52%,
    var(--quality-end) 100%
  );
}

.quality-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quality-hero-kicker {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--muted-strong);
  text-transform: none;
}

.quality-hero-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--on-accent);
  background: rgba(255, 45, 85, 0.85);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.quality-hero.tone-great .quality-hero-tag {
  background: rgba(52, 199, 89, 0.9);
}

.quality-hero.tone-good .quality-hero-tag {
  background: rgba(255, 159, 10, 0.92);
}

.quality-hero-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.quality-hero-title {
  flex: 1;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.2;
  letter-spacing: 0.5rpx;
  padding-right: 8rpx;
}

.quality-hero-score {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
  min-width: 120rpx;
  /* 斜体右缘视觉补偿，让整块与标题中线更稳 */
  padding-right: 4rpx;
  transform: translateY(2rpx);
}

.quality-hero-score-num {
  font-size: 88rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--text);
  line-height: 0.85;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}

.quality-hero.tone-great .quality-hero-score-num {
  color: #34c759;
}

.quality-hero.tone-miss .quality-hero-score-num,
.quality-hero.tone-low .quality-hero-score-num {
  color: #ff2d55;
}

.quality-hero-score-unit {
  font-size: 24rpx;
  font-weight: 700;
  font-style: italic;
  color: var(--muted-strong);
  line-height: 1;
  /* 贴齐数字基线，避免「分」悬空 */
  transform: translateY(-2rpx);
}

.quality-hero-note {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--muted-strong);
  line-height: 1.4;
}

/* 总时长：收起一行；展开后头部不变、下方内嵌分项列表 */
.quality-hero-dur {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 4rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--hairline);
}

.quality-hero-dur-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 52rpx;
}

.quality-hero-dur-label {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted-strong);
  line-height: 1.2;
}

.quality-hero-dur-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  min-width: 0;
}

.quality-hero-dur-time {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
}

.quality-hero-dur-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--fill-soft);
  flex-shrink: 0;
}

.quality-hero-dur.open .quality-hero-dur-toggle {
  background: var(--fill-mid);
}

.quality-hero-dur-chev {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--muted);
  line-height: 1;
}

.quality-hero-cal {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 4rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--hairline);
  min-height: 52rpx;
}

.quality-hero-cal-label {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted-strong);
  line-height: 1.2;
}

.quality-hero-cal-val {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
}

.quality-hero-cal-note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--dark-muted);
  line-height: 1.35;
}

.quality-hero-breakdown {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: var(--fill-soft);
  box-sizing: border-box;
}

.quality-hero-breakdown-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--hairline-soft);
}

.quality-hero-breakdown-row:last-child {
  border-bottom: none;
}

.quality-hero-breakdown-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quality-hero-breakdown-time {
  flex-shrink: 0;
  min-width: 88rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.quality-hero-breakdown-empty {
  padding: 16rpx 0;
  font-size: 22rpx;
  color: var(--dark-muted);
  line-height: 1.3;
}

/* —— Motion utilities —— */
.pressable-hover {
  opacity: 0.88 !important;
  transform: scale(0.97);
}

.sheet-mask {
  opacity: 0;
  transition: opacity var(--motion-sheet) var(--ease-out);
}

.sheet-mask.sheet-open {
  opacity: 1;
}

.sheet-panel {
  transform: translateY(100%);
  transition: transform var(--motion-sheet) var(--ease-out);
  will-change: transform;
}

.sheet-panel.sheet-open {
  transform: translateY(0);
}

.stagger-root .stagger-item {
  opacity: 0;
  transform: translateY(12rpx);
}

.stagger-root.entered .stagger-item {
  animation: motion-stagger-in var(--motion-in) var(--ease-out) forwards;
}

.stagger-root.entered.settled .stagger-item {
  opacity: 1;
  transform: none;
  animation: none;
}

.stagger-root.entered .stagger-item:nth-child(1),
.stagger-root.entered .stagger-d0 {
  animation-delay: 0ms;
}
.stagger-root.entered .stagger-item:nth-child(2),
.stagger-root.entered .stagger-d1 {
  animation-delay: 40ms;
}
.stagger-root.entered .stagger-item:nth-child(3),
.stagger-root.entered .stagger-d2 {
  animation-delay: 80ms;
}
.stagger-root.entered .stagger-item:nth-child(4),
.stagger-root.entered .stagger-d3 {
  animation-delay: 120ms;
}
.stagger-root.entered .stagger-item:nth-child(5),
.stagger-root.entered .stagger-d4 {
  animation-delay: 160ms;
}
.stagger-root.entered .stagger-item:nth-child(6),
.stagger-root.entered .stagger-d5 {
  animation-delay: 200ms;
}
.stagger-root.entered .stagger-item:nth-child(7),
.stagger-root.entered .stagger-d6 {
  animation-delay: 240ms;
}
.stagger-root.entered .stagger-item:nth-child(8),
.stagger-root.entered .stagger-d7 {
  animation-delay: 280ms;
}

@keyframes motion-stagger-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.pop-num {
  transform: scale(1);
}

.pop-num.pop {
  animation: motion-pop-num 320ms var(--ease-out);
}

@keyframes motion-pop-num {
  0% {
    opacity: 0.55;
    transform: scale(1.2);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}
