.sheet {
  height: 72vh;
  background: var(--card);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--s4) calc(var(--s3) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: var(--s2) auto var(--s1);
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--s2) 0 var(--s3);
  gap: var(--s3);
}

.titles {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--text);
}

.sub {
  display: block;
  margin-top: var(--s1);
  font-size: var(--fs-sm);
  color: var(--muted);
}

.close {
  color: var(--accent);
  font-size: var(--fs-md);
  font-weight: 500;
  padding: var(--s1) 0 var(--s1) var(--s2);
}

.body {
  flex: 1;
  height: 0;
}

.section-title {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--muted);
  margin-bottom: var(--s2);
}

.cue {
  display: flex;
  align-items: flex-start;
  gap: var(--s1);
  padding: var(--s1) 0;
}

.dot {
  color: var(--accent);
  font-weight: 700;
  line-height: 1.4;
}

.cue-text {
  flex: 1;
  font-size: var(--fs-md);
  color: var(--text);
  line-height: 1.45;
}

.video-card {
  margin-bottom: var(--s3);
}

.video-title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 600;
  margin-bottom: var(--s2);
  color: var(--text);
}

.video {
  width: 100%;
  height: 360rpx;
  border-radius: var(--r-lg);
  background: var(--bg);
}
