.sheet {
  height: 84vh;
  background: #191919;
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  display: flex;
  flex-direction: column;
  padding: 0 28rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 16rpx auto 8rpx;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 0 16rpx;
  flex-shrink: 0;
}

.titles {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}

.goal {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.35;
}

.goal.sub {
  margin-top: 4rpx;
  font-weight: 400;
  color: var(--muted);
  font-size: 22rpx;
}

.close {
  color: var(--accent);
  font-size: var(--fs-md);
  font-weight: 500;
  padding: 4rpx 0 4rpx 12rpx;
  flex-shrink: 0;
}

.body {
  flex: 1;
  height: 0;
}

.week {
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #2c2c2c;
  overflow: hidden;
}

.week.on {
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.week-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 22rpx;
}

.week-h-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.week-t {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.week-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 4rpx 10rpx;
  border-radius: var(--r-sm);
}

.week-chev {
  font-size: 22rpx;
  color: var(--dark-muted);
}

.day {
  border-top: 1rpx solid var(--hairline-soft);
}

.day-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 14rpx 22rpx;
}

.wd {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
}

.day.strength .wd,
.day.done .wd {
  color: var(--accent);
}

.day-sum {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day.rest .day-sum,
.day.empty .day-sum,
.day.leave .day-sum,
.day.missed .day-sum {
  color: var(--muted);
  font-weight: 500;
}

.day-chip {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--dark-muted);
  background: var(--fill-mid);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.day-chev {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--label-tertiary);
}

.day-detail {
  padding: 0 22rpx 18rpx 86rpx;
}

.sec-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--muted-strong);
  margin-bottom: 8rpx;
}

.sec-label.gap {
  margin-top: 16rpx;
}

.set-cards {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.set-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.set-i {
  width: 28rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  font-style: italic;
  color: var(--dark-muted);
  text-align: center;
}

.set-mid {
  flex: 1;
  min-width: 0;
}

.set-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.set-detail {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--dark-muted);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.set-kg {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.note {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.4;
  padding: 4rpx 0 8rpx;
}

.day-detail .quality-hero {
  margin-bottom: 12rpx;
}

.day-detail .quality-hero-title {
  font-size: 30rpx;
}

.day-detail .quality-hero-score-num {
  font-size: 48rpx;
}
