<view class="page page-dock" style="padding-top: {{navPadTop}}px;" wx:if="{{ready}}">
  <view class="ambient-glow" aria-hidden="true">
    <view class="ambient-blob a"></view>
    <view class="ambient-blob b"></view>
  </view>
  <scroll-view
    scroll-y
    class="page-scroll"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    enable-flex="{{true}}"
    style="background: transparent;"
  >
    <view class="stagger-root {{motionEntered ? 'entered' : ''}} {{motionSettled ? 'settled' : ''}}">
    <view class="header stagger-item stagger-d0">
      <view class="header-text">
        <view class="page-title">{{cycleName}}</view>
        <view class="page-sub">{{weekLine}}</view>
        <view class="page-sub" wx:if="{{weekHint}}">{{weekHint}}</view>
      </view>
      <view
        class="avatar {{avatarUrl ? 'has-photo' : ''}}"
        hover-class="pressable-hover"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="goMe"
        aria-role="button"
        aria-label="个人中心"
      >
        <image
          class="avatar-img {{avatarUrl ? 'filled' : 'placeholder'}}"
          src="{{avatarUrl || '/assets/icon-me.png'}}"
          mode="{{avatarUrl ? 'aspectFill' : 'aspectFit'}}"
        />
      </view>
    </view>

    <view class="week-tabs stagger-item stagger-d1">
      <view
        wx:for="{{ui.slots}}"
        wx:key="calendarWeekday"
        class="tab {{item.active ? 'active' : ''}} {{item.empty ? 'empty' : ''}} {{item.left ? 'left' : ''}} {{item.missed ? 'missed' : ''}} {{item.done ? 'done' : ''}}"
        hover-class="{{item.empty ? '' : 'pressable-hover'}}"
        hover-start-time="0"
        hover-stay-time="80"
        data-index="{{index}}"
        bindtap="selectDay"
        aria-disabled="{{item.empty}}"
      >
        <view class="tab-group">
          <view class="tab-mark" aria-hidden="true"></view>
          <view class="tab-copy">
            <text class="d">{{item.dayLabel}}</text>
            <text class="l">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="stagger-item stagger-d2">
    <view class="body-adjust" wx:if="{{ui.showBodyAdjust}}">
      <view class="body-adjust-label">今天感觉怎么样</view>
      <view class="chip-row">
        <view
          wx:for="{{bodyOptions}}"
          wx:key="id"
          class="chip chip-equal {{body === item.id ? 'active' : ''}}"
          hover-class="pressable-hover"
          hover-start-time="0"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="pickBody"
        >{{item.label}}</view>
      </view>
      <view class="body-adjust-note" wx:if="{{ui.adjustNote}}">{{ui.adjustNote}}</view>
    </view>

    <view class="plan-card">
      <view class="card-top">
        <view
          class="quality-hero tone-{{ui.qualityTone || 'mid'}}"
          wx:if="{{ui.showQualityBanner}}"
        >
          <view class="quality-hero-top">
            <text class="quality-hero-kicker">{{ui.qualityKicker}}</text>
            <text class="quality-hero-tag">{{ui.statusChip}}</text>
          </view>
          <view class="quality-hero-body">
            <text class="quality-hero-title">{{ui.qualityTitle}}</text>
            <view class="quality-hero-score" wx:if="{{ui.qualityScore != null}}">
              <text class="quality-hero-score-num">{{ui.qualityScore}}</text>
              <text class="quality-hero-score-unit">分</text>
            </view>
          </view>
          <view
            class="quality-hero-dur {{durationExpanded ? 'open' : ''}}"
            wx:if="{{ui.showDuration}}"
          >
            <view
              class="quality-hero-dur-head"
              catchtap="toggleDuration"
              aria-role="button"
            >
              <text class="quality-hero-dur-label">一共练了多久</text>
              <view class="quality-hero-dur-right">
                <text class="quality-hero-dur-time">{{ui.durationText}}</text>
                <view class="quality-hero-dur-toggle">
                  <text class="quality-hero-dur-chev">{{durationExpanded ? '▴' : '▾'}}</text>
                </view>
              </view>
            </view>
            <view class="quality-hero-breakdown" wx:if="{{durationExpanded}}">
              <block wx:if="{{ui.hasDurationItems}}">
                <view
                  class="quality-hero-breakdown-row"
                  wx:for="{{ui.durationItems}}"
                  wx:key="index"
                >
                  <text class="quality-hero-breakdown-name">{{item.title}}</text>
                  <text class="quality-hero-breakdown-time">{{item.timeText}}</text>
                </view>
              </block>
              <text class="quality-hero-breakdown-empty" wx:else>还没有分段用时</text>
            </view>
          </view>
          <view class="quality-hero-cal" wx:if="{{ui.showCalories}}">
            <text class="quality-hero-cal-label">大约消耗</text>
            <text class="quality-hero-cal-val">{{ui.calorieText}}</text>
          </view>
          <text class="quality-hero-cal-note" wx:if="{{ui.showCalories && ui.calorieNote}}">{{ui.calorieNote}}</text>
          <text class="quality-hero-note" wx:if="{{ui.qualityNote}}">{{ui.qualityNote}}</text>
        </view>

        <block wx:if="{{ui.isEmpty}}">
          <view class="main-left">
            <text class="main-name empty-label">无</text>
          </view>
        </block>

        <block wx:elif="{{ui.showSetCards}}">
          <view class="sec-head">
            <text class="sec-label">{{ui.secMainLabel}}</text>
          </view>
          <view class="set-cards">
            <view class="set-card tone-{{item.tone}}" wx:for="{{ui.mainCards}}" wx:key="index">
              <view class="set-card-order">
                <text class="set-card-order-num">{{index + 1}}</text>
              </view>
              <view class="set-card-mid">
                <view class="set-card-top">
                  <text class="set-card-name">{{item.name}}</text>
                  <text class="status-chip" wx:if="{{item.showStatus && !ui.showQualityBanner}}">{{item.statusChip}}</text>
                </view>
                <text class="set-card-detail">{{item.detail}}</text>
              </view>
              <view class="kg-plate {{item.plateClass}}">
                <text class="kg-plate-num">{{item.kgText}}</text>
                <text class="kg-plate-unit" wx:if="{{item.hasKg}}">kg</text>
                <text class="kg-plate-unit" wx:elif="{{item.plateUnit}}">{{item.plateUnit}}</text>
              </view>
            </view>
          </view>

          <block wx:if="{{ui.accCards.length}}">
            <view class="sec-head sec-gap">
              <text class="sec-label">{{ui.secAccLabel}}</text>
            </view>
            <view class="set-cards">
              <view class="set-card tone-{{item.tone}}" wx:for="{{ui.accCards}}" wx:key="index">
                <view class="set-card-order">
                  <text class="set-card-order-num">{{index + 1}}</text>
                </view>
                <view class="set-card-mid">
                  <view class="set-card-top">
                    <text class="set-card-name">{{item.name}}</text>
                  </view>
                  <text class="set-card-detail">{{item.detail}}</text>
                </view>
                <view class="kg-plate {{item.plateClass}}">
                  <text class="kg-plate-num">{{item.kgText}}</text>
                  <text class="kg-plate-unit" wx:if="{{item.hasKg}}">kg</text>
                  <text class="kg-plate-unit" wx:elif="{{item.plateUnit}}">{{item.plateUnit}}</text>
                </view>
              </view>
            </view>
          </block>

          <view class="acc-label sec-gap" wx:if="{{ui.isAux && ui.auxNote}}">{{ui.auxNote}}</view>
        </block>

        <block wx:elif="{{ui.isRest}}">
          <view class="sec-head">
            <text class="sec-label">休息日</text>
          </view>
          <view class="main-left">
            <text class="main-name">轻松恢复</text>
          </view>
          <view class="acc-label sec-gap">{{ui.restNote}}</view>
        </block>

        <block wx:else>
          <view class="sec-head">
            <text class="sec-label">{{ui.auxName || '加练'}}</text>
            <text class="status-chip" wx:if="{{ui.showStatus}}">{{ui.statusChip}}</text>
          </view>
          <view class="acc-label">{{ui.auxNote}}</view>
        </block>
      </view>
    </view>
    </view>
    </view>
  </scroll-view>

  <view class="footer" wx:if="{{!ui.isEmpty && (ui.showLeaveActions || ui.showStart || ui.showRestActions || (!viewIsToday && !ui.isMissed && !ui.isLeave && !ui.isCompleted))}}">
    <block wx:if="{{ui.showLeaveActions}}">
      <view class="btn-link" bindtap="revokeLeave">撤销请假</view>
    </block>
    <block wx:elif="{{ui.showStart && ui.auxClosed}}">
      <view class="btn-link">{{ui.auxNote}}</view>
    </block>
    <block wx:elif="{{ui.showStart}}">
      <view class="footer-row" wx:if="{{ui.showLeaveLink}}">
        <button
          class="btn-secondary footer-btn-side"
          hover-class="pressable-hover"
          hover-start-time="0"
          hover-stay-time="80"
          bindtap="markLeave"
          aria-label="今天请假"
        >😴</button>
        <button
          class="btn-primary footer-btn-main"
          hover-class="pressable-hover"
          hover-start-time="0"
          hover-stay-time="80"
          bindtap="start"
        >{{ui.ctaText}}</button>
      </view>
      <button
        class="btn-primary"
        wx:else
        hover-class="pressable-hover"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="start"
      >{{ui.ctaText}}</button>
    </block>
    <block wx:elif="{{ui.showRestActions}}">
      <button
        class="btn-outline"
        hover-class="pressable-hover"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="goCycle"
        >看看这周安排</button>
    </block>
    <block wx:else>
      <view class="btn-link">只能练今天的课，过去的补不了</view>
    </block>
  </view>
</view>

<view class="page" wx:else>
  <view class="page-sub">加载中…</view>
</view>

<move-sheet show="{{moveSheetShow}}" move-name="{{moveSheetName}}" bind:close="closeMoveSheet" />
