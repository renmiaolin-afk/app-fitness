.page {
  position: relative;
  background: transparent;
  padding-top: 0;
}

.ambient-glow {
  position: absolute;
  left: -32rpx;
  right: -32rpx;
  top: 0;
  height: 480rpx;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.ambient-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-blob.a {
  width: 140%;
  height: 90%;
  left: -25%;
  top: -42%;
  background: radial-gradient(
    ellipse at center,
    rgba(255, 45, 85, 0.16) 0%,
    rgba(255, 69, 58, 0.06) 40%,
    transparent 72%
  );
}

.ambient-blob.b {
  width: 100%;
  height: 60%;
  right: -28%;
  left: auto;
  top: -18%;
  background: radial-gradient(
    ellipse at center,
    rgba(255, 45, 85, 0.08) 0%,
    transparent 66%
  );
}

.page-scroll {
  position: relative;
  z-index: 1;
  padding-bottom: 24rpx;
}

.stack {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-top: 12rpx;
}

/* —— Profile（Airbnb 居中头像） —— */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
}

.avatar-btn {
  width: 144rpx !important;
  height: 144rpx !important;
  min-width: 144rpx !important;
  min-height: 144rpx !important;
  max-width: 144rpx;
  max-height: 144rpx;
  border-radius: 50% !important;
  background: var(--chip);
  padding: 0 !important;
  margin: 0 0 28rpx !important;
  border: none !important;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.avatar-btn::after {
  border: none !important;
}

.avatar-img.filled {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  display: block;
}

.avatar-img.placeholder {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.7;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
  letter-spacing: -0.6rpx;
  text-align: center;
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

.meta {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--muted-strong);
  line-height: 1.4;
}

.meta-dot {
  margin: 0 12rpx;
  font-size: 26rpx;
  color: var(--label-tertiary);
}

/* —— Sections —— */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.4rpx;
  line-height: 1.25;
}

.section-action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  text-decoration: underline;
  text-underline-offset: 6rpx;
  padding: 8rpx 0 8rpx 20rpx;
}

.panel {
  background: var(--quality-mid);
  border-radius: 28rpx;
  border: 1rpx solid var(--hairline-soft);
  overflow: hidden;
}

/* —— 三大项 —— */
.total-block {
  padding: 36rpx 36rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline-soft);
}

.total-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--dark-muted);
  margin-bottom: 10rpx;
}

.total-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
}

.total-val {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 0.95;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.total-unit {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--dark-muted);
}

.lifts-row {
  display: flex;
  flex-direction: row;
}

.lift {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 28rpx 20rpx 32rpx 36rpx;
  border-right: 1rpx solid var(--hairline-soft);
}

.lift:last-child {
  border-right: none;
  padding-right: 36rpx;
}

.lift:nth-child(2) {
  padding-left: 28rpx;
}

.lift:nth-child(3) {
  padding-left: 28rpx;
}

.lift-name {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--dark-muted);
  line-height: 1.2;
}

.lift-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.lift-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--label-tertiary);
  margin-top: -2rpx;
}

/* —— 计划 —— */
.plan-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx;
}

.plan-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.plan-meta {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--muted-strong);
  line-height: 1.35;
}

.plan-goal {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plan-goal-k {
  font-size: 24rpx;
  color: var(--dark-muted);
  font-weight: 400;
}

.plan-goal-v {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
}

.chev {
  flex-shrink: 0;
  font-size: 40rpx;
  font-weight: 300;
  color: var(--label-tertiary);
  line-height: 1;
  margin-top: -4rpx;
}

.link-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 36rpx;
}

.link-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.3;
}

/* —— 习惯 rows —— */
.rows-panel {
  padding: 8rpx 36rpx;
}

.row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline-soft);
}

.row.last {
  border-bottom: none;
}

.row-k {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.row-v {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--muted-strong);
  text-align: right;
}

/* —— Footer：左弱「重新建档」· 右强「关闭」 —— */
.me-footer {
  background: transparent;
  padding-top: 12rpx;
}

.footer-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
}

.btn-secondary {
  min-height: var(--btn-h);
  height: auto;
  border-radius: var(--btn-r);
  background: var(--fill-soft);
  color: rgba(255, 45, 85, 0.85);
  font-size: var(--fs-sm);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--btn-pad-y) 20rpx;
  margin: 0;
  border: none;
  line-height: 1.25;
  box-sizing: border-box;
  white-space: normal;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.footer-btn-side {
  flex: 0 1 auto;
  max-width: 52%;
  width: auto !important;
  margin: 0 !important;
}

.footer-btn-main {
  flex: 1;
  min-width: 0;
  width: auto !important;
  margin: 0 !important;
}
