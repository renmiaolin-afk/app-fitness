.page {
  position: relative;
  background: transparent;
  padding-top: 0;
}

.ambient-glow {
  position: absolute;
  left: -32rpx;
  right: -32rpx;
  top: 0;
  height: 480rpx;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.ambient-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-blob.a {
  width: 140%;
  height: 90%;
  left: -25%;
  top: -42%;
  background: radial-gradient(
    ellipse at center,
    rgba(255, 45, 85, 0.16) 0%,
    rgba(255, 69, 58, 0.06) 40%,
    transparent 72%
  );
}

.ambient-blob.b {
  width: 100%;
  height: 60%;
  right: -28%;
  left: auto;
  top: -18%;
  background: radial-gradient(
    ellipse at center,
    rgba(255, 45, 85, 0.08) 0%,
    transparent 66%
  );
}

.page-scroll {
  position: relative;
  z-index: 1;
  padding-bottom: 24rpx;
}

.stack {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-top: 12rpx;
}

/* —— Profile（Airbnb 居中头像） —— */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
}

.avatar-btn {
  width: 144rpx !important;
  height: 144rpx !important;
  min-width: 144rpx !important;
  min-height: 144rpx !important;
  max-width: 144rpx;
  max-height: 144rpx;
  border-radius: 50% !important;
  background: #2c2c2e;
  padding: 0 !important;
  margin: 0 0 28rpx !important;
  border: none !important;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.avatar-btn::after {
  border: none !important;
}

.avatar-img.filled {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  display: block;
}

.avatar-img.placeholder {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.7;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  letter-spacing: -0.6rpx;
  text-align: center;
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

.meta {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(235, 235, 245, 0.55);
  line-height: 1.4;
}

.meta-dot {
  margin: 0 12rpx;
  font-size: 26rpx;
  color: rgba(235, 235, 245, 0.28);
}

/* —— Sections —— */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.4rpx;
  line-height: 1.25;
}

.section-action {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  text-decoration: underline;
  text-underline-offset: 6rpx;
  padding: 8rpx 0 8rpx 20rpx;
}

.panel {
  background: rgba(28, 28, 30, 0.72);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

/* —— 三大项 —— */
.total-block {
  padding: 36rpx 36rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.total-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.48);
  margin-bottom: 10rpx;
}

.total-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
}

.total-val {
  font-size: 80rpx;
  font-weight: 700;
  color: #fff;
  line-height: 0.95;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.total-unit {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.4);
}

.lifts-row {
  display: flex;
  flex-direction: row;
}

.lift {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 28rpx 20rpx 32rpx 36rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.06);
}

.lift:last-child {
  border-right: none;
  padding-right: 36rpx;
}

.lift:nth-child(2) {
  padding-left: 28rpx;
}

.lift:nth-child(3) {
  padding-left: 28rpx;
}

.lift-name {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.45);
  line-height: 1.2;
}

.lift-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.lift-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.35);
  margin-top: -2rpx;
}

/* —— 计划 —— */
.plan-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx;
}

.plan-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.plan-meta {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(235, 235, 245, 0.5);
  line-height: 1.35;
}

.plan-goal {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plan-goal-k {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.42);
  font-weight: 400;
}

.plan-goal-v {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.chev {
  flex-shrink: 0;
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(235, 235, 245, 0.28);
  line-height: 1;
  margin-top: -4rpx;
}

/* —— 习惯 rows —— */
.rows-panel {
  padding: 8rpx 36rpx;
}

.row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.row.last {
  border-bottom: none;
}

.row-k {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

.row-v {
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(235, 235, 245, 0.5);
  text-align: right;
}

/* —— Footer —— */
.me-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding-top: 12rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.me-close-btn {
  width: 100%;
  margin: 0 !important;
  min-height: 96rpx;
  height: auto;
  border-radius: 999rpx;
  background: #fff;
  color: #111;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  padding: 24rpx 48rpx;
  box-sizing: border-box;
  border: none;
  text-align: center;
}

.me-close-btn::after {
  border: none;
}

.me-footer .me-legal {
  width: 100%;
  margin-top: 0;
  padding: 12rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.5);
}

.me-footer .danger {
  width: 100%;
  color: rgba(255, 45, 85, 0.8);
  margin-top: 0;
  padding: 8rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
}
