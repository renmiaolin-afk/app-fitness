<view class="page page-dock" style="padding-top: {{navPadTop}}px;" wx:if="{{ready}}">
  <view class="ambient-glow" aria-hidden="true">
    <view class="ambient-blob a"></view>
    <view class="ambient-blob b"></view>
  </view>

  <scroll-view
    scroll-y
    class="page-scroll"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    enable-flex="{{true}}"
  >
    <view class="stack">
      <!-- 个人资料：居中头像 + 姓名 -->
      <view class="profile">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image
            class="avatar-img {{avatarUrl ? 'filled' : 'placeholder'}}"
            src="{{avatarUrl || '/assets/icon-me.png'}}"
            mode="{{avatarUrl ? 'aspectFill' : 'aspectFit'}}"
          />
        </button>
        <text class="profile-name">{{displayName}}</text>
        <view class="meta-row">
          <text class="meta">{{heightCm}} cm</text>
          <text class="meta-dot">·</text>
          <text class="meta">{{weightKg}} kg</text>
          <text class="meta-dot">·</text>
          <text class="meta">{{genderLabel}}</text>
          <text class="meta-dot">·</text>
          <text class="meta">{{ageYears}} 岁</text>
        </view>
      </view>

      <!-- 三大项 -->
      <view class="section">
        <view class="section-head">
          <text class="section-title">三大项</text>
          <text class="section-action" bindtap="reOnboard">编辑</text>
        </view>
        <view class="panel">
          <view class="total-block">
            <text class="total-label">总和</text>
            <view class="total-line">
              <text class="total-val">{{total}}</text>
              <text class="total-unit">kg</text>
            </view>
          </view>
          <view class="lifts-row">
            <view class="lift">
              <text class="lift-name">深蹲</text>
              <text class="lift-val">{{squat}}</text>
              <text class="lift-unit">kg</text>
            </view>
            <view class="lift">
              <text class="lift-name">卧推</text>
              <text class="lift-val">{{bench}}</text>
              <text class="lift-unit">kg</text>
            </view>
            <view class="lift">
              <text class="lift-name">硬拉</text>
              <text class="lift-val">{{deadlift}}</text>
              <text class="lift-unit">kg</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 训练计划 -->
      <view class="section">
        <view class="section-head">
          <text class="section-title">训练计划</text>
        </view>
        <view
          class="panel plan-panel"
          bindtap="goCycle"
          aria-role="button"
          aria-label="查看训练周期计划"
        >
          <view class="plan-main">
            <text class="plan-name">{{planName}}</text>
            <text class="plan-meta">第 {{week}} / {{totalWeeks}} 周</text>
            <view class="plan-goal" wx:if="{{progressText}}">
              <text class="plan-goal-k">本周期目标</text>
              <text class="plan-goal-v">{{progressText}}</text>
            </view>
          </view>
          <text class="chev">›</text>
        </view>
      </view>

      <!-- 训练习惯 -->
      <view class="section">
        <view class="section-head">
          <text class="section-title">训练习惯</text>
          <text class="section-action" bindtap="editHabits">编辑</text>
        </view>
        <view class="panel rows-panel">
          <view class="row">
            <text class="row-k">训练节奏</text>
            <text class="row-v">{{effortLabel}}</text>
          </view>
          <view class="row">
            <text class="row-k">平时睡眠</text>
            <text class="row-v">{{sleepLabel}}</text>
          </view>
          <view class="row">
            <text class="row-k">身体情况</text>
            <text class="row-v">{{bodyLabel}}</text>
          </view>
          <view class="row last">
            <text class="row-k">单次时长</text>
            <text class="row-v">{{durationLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="footer me-footer">
    <button class="me-close-btn" bindtap="goBack">关闭</button>
    <view class="btn-link me-legal" bindtap="openDisclaimer">法律免责声明</view>
    <view class="btn-link danger" bindtap="resetAll">清除本地数据并重新建档</view>
  </view>
</view>
