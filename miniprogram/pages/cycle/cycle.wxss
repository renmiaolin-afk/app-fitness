.page {
  padding-top: 0;
}

.nav {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--s2);
  min-height: 64rpx;
  background: var(--bg);
}

.page-scroll {
  padding-bottom: calc(var(--s4) + env(safe-area-inset-bottom));
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  color: #fff;
}

.nav-back-chev {
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
  color: #fff;
}

.intro {
  margin-bottom: var(--s4);
}

.intro-name {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  margin-bottom: var(--s3);
  color: var(--text);
}

.fact {
  padding: var(--s2) 0 0;
}

.fact-k {
  display: block;
  font-size: var(--fs-sm);
  color: var(--muted);
  font-weight: 500;
  margin-bottom: var(--s1);
}

.fact-v {
  display: block;
  font-size: var(--fs-lg);
  font-weight: 700;
  line-height: 1.4;
  color: var(--text);
}

.fact-v.sub {
  margin-top: var(--s1);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--muted);
}

.week {
  background: var(--card);
  border-radius: var(--r-card);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.week.on {
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.week-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--s2);
  margin-bottom: var(--s1);
}

.day:first-of-type {
  padding-top: var(--s1);
}

.week-t {
  font-size: var(--fs-md);
  font-weight: 700;
}

.week-tag {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: var(--s1) var(--s2);
  border-radius: var(--r-sm);
}

.day {
  display: flex;
  align-items: flex-start;
  gap: var(--s2);
  padding: 18rpx 0;
}

.wd {
  width: 56rpx;
  flex-shrink: 0;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--muted);
  line-height: 1.45;
  padding-top: 2rpx;
}

.day.strength .wd {
  color: var(--accent);
}

.day.leave .wd,
.day.missed .wd {
  color: var(--muted);
  opacity: 0.85;
}

.day.leave .sec-label,
.day.leave .main-name,
.day.leave .acc-label,
.day.missed .sec-label,
.day.missed .main-name,
.day.missed .acc-label {
  opacity: 0.85;
}

.day.done .wd {
  color: var(--accent);
}

.day-body {
  flex: 1;
  min-width: 0;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  gap: var(--s2);
}

.sec-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: rgba(235, 235, 245, 0.55);
}

.sec-gap {
  margin-top: var(--s4);
}

.day-body .quality-hero {
  margin-bottom: 20rpx;
}

.day-body .quality-hero-title {
  font-size: 36rpx;
}

.day-body .quality-hero-score {
  min-width: 96rpx;
}

.day-body .quality-hero-score-num {
  font-size: 64rpx;
}

.main-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.main-name {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--text);
}

.acc-label {
  color: var(--muted);
  font-size: var(--fs-sm);
  font-weight: 500;
  margin-bottom: var(--s2);
  line-height: 1.45;
}

/* 左顺序 · 中动作/组数 · 右重量（与今天页一致） */
.set-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.set-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.set-card-order {
  width: 48rpx;
  min-width: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-card-order-num {
  font-size: 32rpx;
  font-weight: 800;
  font-style: italic;
  color: rgba(235, 235, 245, 0.45);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.set-card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.set-card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.set-card-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.set-card-detail {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.45);
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-word;
}

.kg-plate {
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  min-height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 35% 30%, #3a3a3c 0%, #1c1c1e 55%, #0a0a0a 100%);
  border: none;
  box-sizing: border-box;
  overflow: hidden;
}

.kg-plate-num {
  font-size: 36rpx;
  font-weight: 800;
  font-style: italic;
  color: #fff;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  text-align: center;
  max-width: 100%;
  padding: 0 4rpx;
}

.kg-plate.bw .kg-plate-num {
  font-size: 26rpx;
  font-style: normal;
}

.kg-plate-unit {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(235, 235, 245, 0.4);
  line-height: 1;
}

.day.rest .sec-label,
.day.rest .main-name,
.day.rest .acc-label {
  color: var(--muted);
}
