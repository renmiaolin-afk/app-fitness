.page {
  padding-top: 0;
}

.nav {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--s3);
  min-height: 64rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  color: #fff;
}

.nav-back-chev {
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
  color: #fff;
}

.intro {
  margin-bottom: var(--s4);
}

.intro-name {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  margin-bottom: var(--s3);
  color: var(--text);
}

.fact {
  padding: var(--s2) 0 0;
}

.fact-k {
  display: block;
  font-size: var(--fs-sm);
  color: var(--muted);
  font-weight: 500;
  margin-bottom: var(--s1);
}

.fact-v {
  display: block;
  font-size: var(--fs-lg);
  font-weight: 700;
  line-height: 1.4;
  color: var(--text);
}

.fact-v.sub {
  margin-top: var(--s1);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--muted);
}

.week {
  background: var(--card);
  border-radius: var(--r-card);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.week.on {
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.week-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--s2);
  margin-bottom: var(--s1);
}

.day:first-of-type {
  padding-top: var(--s1);
}

.week-t {
  font-size: var(--fs-md);
  font-weight: 700;
}

.week-tag {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: var(--s1) var(--s2);
  border-radius: var(--r-sm);
}

.day {
  display: flex;
  align-items: flex-start;
  gap: var(--s2);
  padding: 18rpx 0;
}

.wd {
  width: 40rpx;
  flex-shrink: 0;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--muted);
  line-height: 1.45;
  padding-top: 2rpx;
}

.day.strength .wd {
  color: var(--accent);
}

.body {
  flex: 1;
  min-width: 0;
}

.sec-label {
  display: block;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.sec-label.acc {
  margin-top: var(--s2);
}

.main-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--s2);
}

.t {
  font-size: var(--fs-md);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
  min-width: 0;
}

.t.muted {
  color: var(--muted);
  font-weight: 500;
}

.sets {
  flex-shrink: 0;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--accent);
  text-align: right;
}

.acc-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--s2);
  padding-top: 6rpx;
}

.acc-n {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text);
  min-width: 0;
  line-height: 1.4;
}

.acc-s {
  flex-shrink: 0;
  font-size: var(--fs-sm);
  color: var(--muted);
  text-align: right;
}

.day.rest .t,
.day.rest .sec-label {
  color: var(--muted);
}
