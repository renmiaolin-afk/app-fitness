.legal-intro {
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(235, 235, 245, 0.68);
  line-height: 1.55;
}

.legal-card {
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(28, 28, 30, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.legal-note {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(235, 235, 245, 0.45);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.5;
}

.legal-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.legal-block:last-of-type {
  margin-bottom: 20rpx;
}

.legal-h {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.legal-p {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(235, 235, 245, 0.62);
  line-height: 1.55;
  white-space: pre-wrap;
}

.legal-ver {
  display: block;
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.32);
  font-weight: 500;
}

.disc-footer {
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.check-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 4rpx 4rpx;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(235, 235, 245, 0.35);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.check-row.on .check-box {
  border-color: var(--accent);
  background: var(--accent);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.check-label {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.78);
  line-height: 1.4;
}

.check-row.on .check-label {
  color: #fff;
}

.btn-primary.locked,
.btn-primary[disabled] {
  opacity: 0.42;
  background: rgba(255, 255, 255, 0.18) !important;
  background-image: none !important;
  color: rgba(255, 255, 255, 0.65) !important;
}

.disc-exit {
  margin-top: 0;
  padding-bottom: 0;
  color: rgba(235, 235, 245, 0.45);
}
