.analyzing {
  margin-top: var(--s4);
  display: flex;
  align-items: center;
  gap: var(--s3);
  padding: var(--s2) 0;
}

.analyzing-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.85;
  flex-shrink: 0;
}

.analyzing-text {
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--muted);
  line-height: 1.4;
}

.plan-stack {
  margin-top: var(--s4);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: var(--s3);
}

.hero-card {
  border-radius: 36rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 3rpx solid transparent;
}

.hero-card.tone-0 {
  background: var(--hero-0);
}

.hero-card.tone-1 {
  background: var(--hero-1);
}

.hero-card.tone-2 {
  background: var(--hero-2);
}

.hero-card.tone-3 {
  background: var(--hero-3);
}

.hero-card.selected,
.hero-card.tone-0.selected,
.hero-card.tone-1.selected,
.hero-card.tone-2.selected,
.hero-card.tone-3.selected {
  border-color: var(--accent);
  background: var(--hero-selected);
}

.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.5rpx;
  color: var(--text);
}

.hero-result {
  margin-top: 16rpx;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text);
  line-height: 1.45;
}

.hero-blurb {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  font-weight: 400;
  color: var(--muted);
  line-height: 1.5;
}

.week-block {
  margin-top: 32rpx;
}

.week-caption {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--muted-strong);
  margin-bottom: 12rpx;
}

.week-row {
  display: flex;
  gap: 8rpx;
  width: 100%;
  margin-top: 0;
}

.page-scroll.dragging {
  overflow: hidden;
}

.start-row {
  display: flex;
  gap: var(--s2);
  margin-bottom: 16rpx;
}

.drag-hint {
  font-size: var(--fs-sm);
  color: var(--muted);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.week-cell {
  flex: 1 1 0;
  min-width: 0;
  border-radius: 14rpx;
  padding: 12rpx 2rpx 14rpx;
  text-align: center;
  background: var(--fill-soft);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: transform 0.12s ease, opacity 0.12s ease, border-color 0.12s ease;
}

.week-cell.train {
  background: rgba(255, 45, 85, 0.16);
}

.week-cell.rest {
  background: var(--fill-soft);
}

.week-cell.dragging {
  transform: scale(1.08);
  opacity: 0.95;
  border-color: rgba(255, 255, 255, 0.45);
  z-index: 2;
}

.week-cell.drag-over {
  border-color: var(--accent);
  background: rgba(255, 45, 85, 0.28);
}

.wd {
  display: block;
  font-size: 20rpx;
  color: var(--dark-muted);
  line-height: 1.2;
}

.wl {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-cell.train .wl {
  color: #ff8aa0;
}

.week-cell.rest .wl {
  color: var(--label-tertiary);
  font-weight: 500;
}
