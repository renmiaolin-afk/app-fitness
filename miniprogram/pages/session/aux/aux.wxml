<ambient-glow intensity="{{glowIntensity}}" />


<view class="train" style="padding-top: {{navPadTop}}px;">
  <view class="top">
    <text class="phase-label" wx:if="{{phaseLabel}}">{{phaseLabel}}</text>
    <text class="name">{{title}}</text>
    <view class="progress" wx:if="{{dotsCompact}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPct}}%;"></view>
      </view>
      <text class="progress-label">{{progressLabel}}</text>
    </view>
    <view class="dots" wx:else>
      <view wx:for="{{dots}}" wx:key="index" class="dot {{item}}"></view>
    </view>
    <view class="sub">{{subText}}</view>
  </view>

  <view class="mid">
    <view
      class="ring {{timerHot ? 'hot' : ''}} {{paused ? 'paused' : ''}}"
      style="background: conic-gradient(from -90deg, {{ringColor}} {{ringPct}}%, rgba(255,255,255,0.12) 0);"
    >
      <view class="ring-inner">
        <text class="ring-time" style="color: {{ringColor}};">{{timerText}}</text>
        <text class="ring-hint">{{zoneText}}</text>
      </view>
    </view>
    <view class="howto" wx:if="{{howto}}">{{howto}}</view>
    <view class="load" wx:if="{{loadText}}">{{loadText}}</view>
  </view>

  <view class="bottom">
    <view class="cta-row">
      <view
        class="btn-side icon"
        hover-class="pressable-hover"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="togglePause"
        aria-role="button"
        aria-label="{{paused ? '继续' : '暂停'}}"
      >{{paused ? '▶' : '⏸'}}</view>
      <button
        class="btn-primary cta-main {{canComplete ? '' : 'locked'}}"
        hover-class="pressable-hover"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="next"
        disabled="{{!canComplete}}"
      >{{completeLabel}}</button>
      <view
        class="btn-side icon"
        hover-class="pressable-hover"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="openExit"
        aria-role="button"
        aria-label="关闭"
      >✕</view>
    </view>
  </view>

  <view
    class="mask sheet-mask {{sheetOpen ? 'sheet-open' : ''}}"
    wx:if="{{showExit}}"
    catchtouchmove="noop"
    bindtap="closeExit"
  >
    <view class="sheet sheet-panel {{sheetOpen ? 'sheet-open' : ''}}" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">先离开一下？</view>
      <view class="sheet-desc">练过的段落会留着，今天还能接着练。</view>
      <view class="sheet-actions">
        <view class="sheet-row">
          <button
            class="sheet-btn sheet-btn-primary"
            hover-class="pressable-hover"
            hover-start-time="0"
            hover-stay-time="80"
            bindtap="closeExit"
          >继续练</button>
          <button
            class="sheet-btn sheet-btn-secondary"
            hover-class="pressable-hover"
            hover-start-time="0"
            hover-stay-time="80"
            bindtap="saveExit"
          >先走，一会再练</button>
        </view>
        <view
          class="sheet-btn-danger"
          hover-class="pressable-hover"
          hover-start-time="0"
          hover-stay-time="80"
          bindtap="discardExit"
        >这次不算了，不保存</view>
      </view>
    </view>
  </view>
</view>
