<ambient-glow intensity="{{glowIntensity}}" />


<view class="train" style="padding-top: {{navPadTop}}px;">
  <view class="top">
    <text class="phase-label" wx:if="{{phaseLabel}}">{{phaseLabel}}</text>
    <text class="name">{{name}}</text>
    <view class="progress" wx:if="{{dotsCompact}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPct}}%;"></view>
      </view>
      <text class="progress-label">{{progressLabel}}</text>
    </view>
    <view class="dots" wx:else>
      <view wx:for="{{dots}}" wx:key="index" class="dot {{item}}"></view>
    </view>
    <view class="sub">{{subText}}</view>
  </view>

  <view class="mid">
    <view
      class="ring {{timerHot ? 'hot' : ''}} {{phase === 'rest' ? 'rest' : ''}} {{paused ? 'paused' : ''}}"
      style="background: conic-gradient(from -90deg, {{ringColor}} {{ringPct}}%, rgba(255,255,255,0.12) 0);"
    >
      <view class="ring-inner">
        <text class="ring-time" style="color: {{ringColor}};">{{displayTime}}</text>
        <text class="ring-hint">{{unitHint}}</text>
      </view>
    </view>

    <view class="load">
      <view class="kg-row" wx:if="{{kgLabel}}">
        <text class="kg">{{kgLabel}}</text>
      </view>
      <view class="kg-row" wx:else>
        <text class="kg">{{kg}}</text>
        <text class="kg-unit">KG</text>
      </view>
      <view class="info">{{targetInfo}}</view>
    </view>
  </view>

  <view class="bottom">
    <block wx:if="{{phase === 'ready'}}">
      <view class="cta-row">
        <view class="btn-side ghost"></view>
        <button class="btn-primary cta-main" bindtap="startSet" disabled="{{showCountdown}}">开始本组</button>
        <view class="btn-side icon" bindtap="openExit" aria-role="button" aria-label="关闭">✕</view>
      </view>
    </block>
    <block wx:elif="{{phase === 'working'}}">
      <view class="cta-row">
        <view
          class="btn-side icon"
          bindtap="togglePause"
          aria-role="button"
          aria-label="{{paused ? '继续' : '暂停'}}"
        >{{paused ? '▶' : '⏸'}}</view>
        <button
          class="btn-primary cta-main {{canComplete ? '' : 'locked'}}"
          bindtap="endSet"
          disabled="{{!canComplete}}"
        >{{completeLabel}}</button>
        <view class="btn-side icon" bindtap="openExit" aria-role="button" aria-label="关闭">✕</view>
      </view>
    </block>
    <block wx:else>
      <view class="cta-row">
        <view class="btn-side" bindtap="addRest">+20</view>
        <button class="btn-primary cta-main" bindtap="nextSet" disabled="{{showCountdown}}">下一组</button>
        <view class="btn-side icon" bindtap="openExit" aria-role="button" aria-label="关闭">✕</view>
      </view>
    </block>
  </view>

  <view class="countdown-mask" wx:if="{{showCountdown}}" catchtouchmove="noop">
    <view class="countdown-num">{{countdownNum}}</view>
    <view class="countdown-label">准备开始</view>
  </view>

  <view class="mask" wx:if="{{showExit}}" catchtouchmove="noop" bindtap="closeExit">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">要离开训练吗？</view>
      <view class="sheet-desc">已完成的组会保存，今天还能接着练。</view>
      <view class="sheet-actions">
        <view class="sheet-row">
          <button class="sheet-btn sheet-btn-primary" bindtap="closeExit">继续练</button>
          <button class="sheet-btn sheet-btn-secondary" bindtap="saveExit">先离开，稍后继续</button>
        </view>
        <view class="sheet-btn-danger" bindtap="discardExit">放弃本次，不保存</view>
      </view>
    </view>
  </view>
</view>
