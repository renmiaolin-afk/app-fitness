.train {
  height: 100%;
  min-height: 100%;
  background: var(--dark);
  color: var(--text);
  display: flex;
  flex-direction: column;
  padding: 0 var(--s4) 0;
  box-sizing: border-box;
  overflow: hidden;
}

.top {
  text-align: center;
  padding-top: 8rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.name {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -1.5rpx;
  color: #fff;
  padding: 0 var(--s2);
}

.head-meta {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.42);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.progress {
  width: 100%;
  max-width: 280rpx;
  padding-top: 6rpx;
}

.progress-track {
  width: 100%;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

.mid {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: 24rpx 0 32rpx;
}

.ring {
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: none;
}

.ring-inner {
  width: 412rpx;
  height: 412rpx;
  border-radius: 50%;
  background: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-time {
  font-size: 128rpx;
  font-weight: 800;
  line-height: 0.92;
  letter-spacing: -5rpx;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.ring-hint {
  margin-top: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.38);
}

.metrics {
  width: 100%;
  max-width: 520rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: center;
  gap: 0;
  padding: 0 16rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.metric-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.38);
  line-height: 1.2;
}

.metric-value-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  min-height: 72rpx;
}

.metric-value {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.metric-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.38);
  letter-spacing: 1rpx;
}

.metric-rule {
  width: 1rpx;
  align-self: stretch;
  margin: 8rpx 8rpx;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

.bottom {
  flex-shrink: 0;
  padding-bottom: calc(var(--s3) + env(safe-area-inset-bottom));
}

.cta-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
}

.btn-side {
  flex-shrink: 0;
  width: 112rpx;
  min-height: var(--btn-h);
  padding: 0 8rpx;
  border-radius: var(--btn-r);
  background: var(--fill-soft);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-side.icon {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
}

.btn-side.ghost {
  visibility: hidden;
  pointer-events: none;
}

.cta-main {
  flex: 1;
  min-width: 0;
}

.btn-primary {
  background: var(--accent);
  border-radius: var(--btn-r);
  min-height: var(--btn-h);
  height: auto;
  line-height: 1.25;
  font-size: var(--fs-md);
  padding: var(--btn-pad-y) 20rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.btn-primary.locked,
.btn-primary[disabled] {
  opacity: 0.42;
  background: var(--fill-mid) !important;
  color: rgba(255, 255, 255, 0.65) !important;
}

.btn-primary[disabled] {
  opacity: 0.45;
}

.btn-ghost.light {
  color: var(--dark-muted);
  margin-top: var(--s2);
  text-align: center;
  font-size: var(--fs-md);
  padding: var(--s1) 0;
}

.countdown-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: var(--overlay-heavy);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.countdown-num {
  font-size: 220rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--accent);
  letter-spacing: -6rpx;
}

.countdown-label {
  margin-top: var(--s3);
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--muted-strong);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sheet {
  width: 100%;
  background: var(--dark-elev);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: 20rpx var(--s4) calc(var(--s4) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--fill-mid);
  margin: 0 auto 28rpx;
}

.sheet-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--text);
  text-align: center;
}

.sheet-desc {
  margin: 12rpx 0 36rpx;
  color: var(--dark-muted);
  font-size: var(--fs-md);
  line-height: 1.45;
  text-align: center;
}

.sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sheet-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
}

.sheet-btn {
  flex: 1;
  min-width: 0;
  width: auto;
  margin: 0 !important;
  min-height: var(--btn-h);
  height: auto;
  border-radius: var(--btn-r);
  font-size: var(--fs-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.25;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  border: none;
  white-space: normal;
  text-align: center;
}

.sheet-btn::after {
  border: none;
}

.sheet-btn-primary {
  background: var(--accent);
  background-image: var(--grad-accent);
  color: var(--on-accent);
}

.sheet-btn-secondary {
  background: var(--fill-soft);
  color: var(--text);
}

.sheet-btn-danger {
  margin-top: 8rpx;
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: rgba(255, 69, 58, 0.78);
  line-height: 1.3;
}
