<ambient-glow />
<view class="page page-dock">
  <scroll-view scroll-y class="page-scroll" enhanced="{{true}}" show-scrollbar="{{false}}" enable-flex="{{true}}">
    <view class="page-title">练完了</view>
    <view class="page-sub">{{name}} · 已经记下来了</view>

    <view class="quality-hero tone-{{tone || 'great'}}" style="margin-top: 32rpx;">
      <view class="quality-hero-top">
        <text class="quality-hero-kicker">这节课怎么样</text>
        <text class="quality-hero-tag">练完了</text>
      </view>
      <view class="quality-hero-body">
        <text class="quality-hero-title">{{title}}</text>
        <view class="quality-hero-score">
          <text class="quality-hero-score-num">{{score}}</text>
          <text class="quality-hero-score-unit">分</text>
        </view>
      </view>
      <view class="quality-hero-dur {{durationExpanded ? 'open' : ''}}" wx:if="{{showDuration}}">
        <view
          class="quality-hero-dur-head"
          catchtap="toggleDuration"
          aria-role="button"
        >
          <text class="quality-hero-dur-label">一共练了多久</text>
          <view class="quality-hero-dur-right">
            <text class="quality-hero-dur-time">{{durationText}}</text>
            <view class="quality-hero-dur-toggle">
              <text class="quality-hero-dur-chev">{{durationExpanded ? '▴' : '▾'}}</text>
            </view>
          </view>
        </view>
        <view class="quality-hero-breakdown" wx:if="{{durationExpanded}}">
          <block wx:if="{{hasDurationItems}}">
            <view
              class="quality-hero-breakdown-row"
              wx:for="{{durationItems}}"
              wx:key="index"
            >
              <text class="quality-hero-breakdown-name">{{item.title}}</text>
              <text class="quality-hero-breakdown-time">{{item.timeText}}</text>
            </view>
          </block>
          <text class="quality-hero-breakdown-empty" wx:else>还没有分段用时</text>
        </view>
      </view>
      <view class="quality-hero-cal" wx:if="{{showCalories}}">
        <text class="quality-hero-cal-label">大约消耗</text>
        <text class="quality-hero-cal-val">{{calorieText}}</text>
      </view>
      <text class="quality-hero-cal-note" wx:if="{{showCalories && calorieNote}}">{{calorieNote}}</text>
    </view>

    <view class="plan-card" wx:if="{{showPlan}}">
      <view class="sec-head">
        <text class="sec-label">{{secMainLabel}}</text>
      </view>
      <view class="set-cards">
        <view class="set-card tone-{{item.tone}}" wx:for="{{mainCards}}" wx:key="index">
          <view class="set-card-order">
            <text class="set-card-order-num">{{index + 1}}</text>
          </view>
          <view class="set-card-mid">
            <view class="set-card-top">
              <text class="set-card-name">{{item.name}}</text>
            </view>
            <text class="set-card-detail">{{item.detail}}</text>
          </view>
          <view class="kg-plate {{item.plateClass}}">
            <text class="kg-plate-num">{{item.kgText}}</text>
            <text class="kg-plate-unit" wx:if="{{item.hasKg}}">kg</text>
            <text class="kg-plate-unit" wx:elif="{{item.plateUnit}}">{{item.plateUnit}}</text>
          </view>
        </view>
      </view>

      <block wx:if="{{accCards.length}}">
        <view class="sec-head sec-gap">
          <text class="sec-label">{{secAccLabel}}</text>
        </view>
        <view class="set-cards">
          <view class="set-card tone-{{item.tone}}" wx:for="{{accCards}}" wx:key="index">
            <view class="set-card-order">
              <text class="set-card-order-num">{{index + 1}}</text>
            </view>
            <view class="set-card-mid">
              <view class="set-card-top">
                <text class="set-card-name">{{item.name}}</text>
              </view>
              <text class="set-card-detail">{{item.detail}}</text>
            </view>
            <view class="kg-plate {{item.plateClass}}">
              <text class="kg-plate-num">{{item.kgText}}</text>
              <text class="kg-plate-unit" wx:if="{{item.hasKg}}">kg</text>
              <text class="kg-plate-unit" wx:elif="{{item.plateUnit}}">{{item.plateUnit}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{hasSets && !showPlan}}">
      <view class="sec">这节课练了啥</view>
      <view class="set" wx:for="{{sets}}" wx:key="index">
        <text>{{item.title}}</text>
        <text class="kg">{{item.detail}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="footer">
    <button class="btn-primary" bindtap="backToday">完成</button>
  </view>
</view>
