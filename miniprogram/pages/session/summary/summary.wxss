.plan-card {
  margin-top: 4rpx;
  margin-bottom: 24rpx;
  padding: 0;
  background: transparent;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  gap: var(--s2);
}

.sec-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--muted-strong);
}

.sec-gap {
  margin-top: var(--s4);
}

.set-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.set-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.set-card-order {
  width: 48rpx;
  min-width: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-card-order-num {
  font-size: 32rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--dark-muted);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.set-card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.set-card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.set-card-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.set-card-detail {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--dark-muted);
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-word;
}

.kg-plate {
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  min-height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--plate-grad);
  box-sizing: border-box;
  overflow: hidden;
}

.kg-plate-num {
  font-size: 36rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  text-align: center;
  max-width: 100%;
  padding: 0 4rpx;
}

.kg-plate.bw .kg-plate-num {
  font-size: 26rpx;
  font-style: normal;
}

.kg-plate-unit {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--dark-muted);
  line-height: 1;
}

.sec {
  font-size: var(--fs-md);
  color: var(--muted);
  font-weight: 500;
}

.set {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: var(--fs-md);
}

.set:first-of-type {
  margin-top: var(--s2);
}

.set .kg {
  color: var(--accent);
  font-weight: 600;
}
