<view class="page page-dock" style="padding-top: {{navPadTop}}px;">
  <view class="page-scroll">
    <view class="app-nav" wx:if="{{showNavBack}}">
      <view class="app-nav-back" bindtap="onNavBack" aria-role="button" aria-label="返回">
        <text class="app-nav-chev">‹</text>
        <text class="app-nav-back-label">{{navBackLabel}}</text>
      </view>
    </view>
    <view class="page-title">今天感觉怎么样</view>
    <view class="page-sub">{{hint}}</view>

    <view class="card" style="margin-top: 32rpx;">
      <view class="card-label">身体状态</view>
      <view class="chip-row">
        <view
          wx:for="{{bodyOptions}}"
          wx:key="id"
          class="chip chip-equal {{body === item.id ? 'active' : ''}}"
          hover-class="pressable-hover"
          hover-start-time="0"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="pick"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="footer">
    <button
      class="btn-primary"
      hover-class="pressable-hover"
      hover-start-time="0"
      hover-stay-time="80"
      bindtap="confirm"
    >{{cta}}</button>
    <view class="btn-link" hover-class="pressable-hover" bindtap="skip">没什么变化，直接开始</view>
  </view>
</view>
